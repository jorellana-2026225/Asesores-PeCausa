```xml
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            styleClass="anchorPane"
            stylesheets="@../resources/styles/ActuacionesStyle.css"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.asesorespecausa.system.controller.ActuacionController">

    <children>

        <!-- Título -->
        <Label alignment="CENTER"
               layoutX="30.0"
               layoutY="15.0"
               prefWidth="500.0"
               styleClass="Label"
               text="REGISTRO DE ACTUACIONES">

            <font>
                <Font name="System Bold" size="22.0" />
            </font>

        </Label>

        <!-- Logo -->
        <ImageView fitHeight="100.0"
                   fitWidth="130.0"
                   layoutX="750.0"
                   layoutY="5.0"
                   pickOnBounds="true"
                   preserveRatio="true">

            <image>
                <Image url="@../resources/images/Llamaa.png" />
            </image>

        </ImageView>

        <!-- Información del expediente -->
        <HBox layoutX="30.0"
              layoutY="70.0"
              spacing="15.0">

            <children>

                <Label styleClass="Label"
                       text="Cliente:" />

                <Label fx:id="lblNombreCliente"
                       styleClass="Label"
                       text="Sin cliente asignado" />

                <Label styleClass="Label"
                       text="Expediente:" />

                <Label fx:id="lblNumeroExpediente"
                       styleClass="Label"
                       text="Sin expediente" />

            </children>

        </HBox>

        <!-- Formulario -->
        <VBox layoutX="30.0"
              layoutY="110.0"
              prefWidth="840.0"
              spacing="8.0">

            <children>

                <Label styleClass="Label"
                       text="Título de la actuación" />

                <TextField fx:id="txtTitulo"
                           promptText="Ingrese el título de la actuación" />

                <Label styleClass="Label"
                       text="Descripción" />

                <TextArea fx:id="txtDescripcion"
                          prefHeight="80.0"
                          promptText="Ingrese la descripción"
                          wrapText="true" />

                <HBox spacing="20.0">

                    <children>

                        <VBox spacing="5.0">

                            <children>

                                <Label styleClass="Label"
                                       text="Fecha de actuación" />

                                <DatePicker fx:id="dpFechaActuacion" />

                            </children>

                        </VBox>

                        <VBox prefWidth="300.0"
                              spacing="5.0">

                            <children>

                                <Label styleClass="Label"
                                       text="Archivo adjunto" />

                                <TextField fx:id="txtArchivoAdjunto"
                                           promptText="Archivo adjunto" />

                            </children>

                        </VBox>

                    </children>

                </HBox>

                <Button fx:id="btnRegistrar"
                        mnemonicParsing="false"
                        onAction="#onRegistrarActuacion"
                        text="Registrar actuación" />

                <!-- Historial -->
                <Label styleClass="Label"
                       text="HISTORIAL DE ACTUACIONES">

                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>

                </Label>

                <!-- Botones de acciones -->
                <HBox spacing="10.0">

                    <children>

                        <Button onAction="#onEliminarActuacion"
                                text="Eliminar" />

                        <Button onAction="#onEditarActuacion"
                                text="Editar" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets left="10.0"
                        right="10.0" />
            </padding>

        </VBox>

        <!-- Tabla -->
        <TableView fx:id="tblActuaciones"
                   layoutX="30.0"
                   layoutY="400.0"
                   prefHeight="220.0"
                   prefWidth="840.0"
                   styleClass="tableView">

            <columns>

                <TableColumn fx:id="colFecha"
                             prefWidth="150.0"
                             text="Fecha" />

                <TableColumn fx:id="colActuacion"
                             prefWidth="250.0"
                             text="Actuación" />

                <TableColumn fx:id="colDetalle"
                             prefWidth="440.0"
                             text="Detalle" />

            </columns>

        </TableView>

        <!-- Cerrar -->
        <Button fx:id="btnCerrar"
                layoutX="790.0"
                layoutY="640.0"
                mnemonicParsing="false"
                onAction="#onCloseActuaciones"
                text="Cerrar" />

    </children>

</AnchorPane>

